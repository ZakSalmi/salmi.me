---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout title="Writing" description="Notes on becoming a better data scientist.">
	<h1>Writing</h1>
	<p class="writing-tagline">Notes on becoming a better data scientist.</p>
	<ul class="entries">
		{posts.map((post) => (
			<li>
				<h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
				<p>{post.data.description}</p>
				<time datetime={post.data.publishedAt.toISOString()}>
					{post.data.publishedAt.toLocaleDateString('en', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					})}
				</time>
			</li>
		))}
	</ul>
</BaseLayout>
