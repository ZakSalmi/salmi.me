---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profilePhoto from '../assets/profile/profile.jpeg';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 2);
---

<BaseLayout description="Zakaria Salmi is a data scientist building machine-learning systems for financial-crime detection.">
	<section class="profile-card" aria-labelledby="intro-heading">
		<div class="profile-portrait">
			<Image
				src={profilePhoto}
				alt="Portrait of Zakaria Salmi in front of a stone amphitheatre"
				width={600}
				class="profile-image"
			/>
		</div>
		<div class="profile-bio">
			<h1 id="intro-heading">Hi! I’m <span>Zakaria Salmi</span></h1>
			<p>
				I’m a data scientist at Wise, building end-to-end machine-learning systems
				that help detect financial crime.
			</p>
			<p>Curious about technology, history, and the arts.</p>
		</div>
	</section>

	<dl class="stat-block" aria-label="A short profile">
		<div>
			<dt>Work</dt>
			<dd><strong>Data Scientist</strong> at <strong>Wise</strong></dd>
		</div>
		<div>
			<dt>Focus</dt>
			<dd><strong>Production ML systems</strong> · <strong>applied deep learning</strong></dd>
		</div>
		<div>
			<dt>Previously</dt>
			<dd><strong>Quant development at Citi</strong> · <strong>data analytics at Sanofi</strong></dd>
		</div>
		<div>
			<dt>Degrees</dt>
			<dd>
				MSc in Computer Science and Data Science (ELTE) · BSc in Computer Science
				and Mathematics (Ibn Tofail University)
			</dd>
		</div>
	</dl>

	<section class="home-writing" aria-labelledby="writing-heading">
		<h2 id="writing-heading">Blog</h2>
		<p class="writing-tagline">Notes on becoming a better data scientist.</p>
		<div class="post-list">
			{posts.map((post) => (
				<a class="post-card" href={`/writing/${post.id}/`}>
					<h3><span aria-hidden="true">→</span>{post.data.title}</h3>
					<p>{post.data.description}</p>
				</a>
			))}
		</div>
		<a class="archive-link" href="/writing/">View all writing →</a>
	</section>

	<section class="contact" aria-labelledby="contact-heading">
		<h2 id="contact-heading" class="visually-hidden">Contact</h2>
		<p><span aria-hidden="true">→</span> Connect:{' '}
			<a href="https://linkedin.com/in/zakaria-salmi" rel="me">LinkedIn</a>{' · '}
			<a href="https://x.com/ZacksCode" rel="me">X (@ZacksCode)</a>{' · '}
			<a href="mailto:zakaria@salmi.me">zakaria@salmi.me</a>
		</p>
	</section>
</BaseLayout>
